# =============================================================
# Roomora — Environment Variable Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================

# ---------------------------------------------------------------
# Supabase (https://supabase.com/dashboard)
# Create a project → Settings → API
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ---------------------------------------------------------------
# Razorpay (https://dashboard.razorpay.com)
# Use TEST mode keys for development.
# The secret key is used ONLY in the sidecar server, never in frontend.
# ---------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
# Server-side only (sidecar/.env):
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ---------------------------------------------------------------
# UIDAI Aadhaar Sandbox (https://developer.uidai.gov.in)
# These credentials MUST remain server-side (sidecar/.env only).
# They are listed here for documentation. Do NOT set them as VITE_ vars.
# ---------------------------------------------------------------
# Server-side only (sidecar/.env):
# UIDAI_CLIENT_ID=your-uidai-sandbox-client-id
# UIDAI_CLIENT_SECRET=your-uidai-sandbox-client-secret
# UIDAI_BASE_URL=https://developer.uidai.gov.in/sandbox
# UIDAI_ENV=sandbox   # or 'production' when fully authorized

# ---------------------------------------------------------------
# App Settings
# ---------------------------------------------------------------
VITE_APP_ENV=development    # 'development' | 'production'
VITE_APP_NAME=Roomora

# ---------------------------------------------------------------
# Sidecar Server (Express webhook handler — runs on separate port)
# ---------------------------------------------------------------
# SIDECAR_PORT=3001
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# (Service role key is for server-side operations only — never expose to frontend)
